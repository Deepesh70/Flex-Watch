<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffd633"/>
      <stop offset="50%" stop-color="#f5c518"/>
      <stop offset="100%" stop-color="#c9a000"/>
    </linearGradient>
    <linearGradient id="darkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141923"/>
      <stop offset="100%" stop-color="#050709"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#f5c518" flood-opacity="0.3"/>
    </filter>
  </defs>

  <!-- Background rounded rectangle -->
  <rect width="512" height="512" rx="128" fill="url(#darkGrad)" stroke="#f5c518" stroke-width="8" stroke-opacity="0.4"/>

  <!-- Golden Outer Film Reel Ring -->
  <circle cx="256" cy="256" r="168" fill="none" stroke="url(#goldGrad)" stroke-width="24" filter="url(#shadow)"/>
  
  <!-- Film Sprocket Holes -->
  <circle cx="256" cy="116" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="256" cy="396" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="116" cy="256" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="396" cy="256" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="157" cy="157" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="355" cy="157" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="157" cy="355" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>
  <circle cx="355" cy="355" r="14" fill="#050709" stroke="#f5c518" stroke-width="4"/>

  <!-- Inner Center Ring -->
  <circle cx="256" cy="256" r="92" fill="#0a0e17" stroke="url(#goldGrad)" stroke-width="12"/>

  <!-- Play Button Triangle -->
  <polygon points="230,200 314,256 230,312" fill="url(#goldGrad)"/>
</svg>
