# Frontend Environment Variables
# Optional backend API URL (leave empty to use relative /api/v1 or local dev proxy)
REACT_APP_BACKEND_URL=

# Clerk Authentication Publishable Key (from https://dashboard.clerk.com)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# (Optional Fallback) TMDB API Key - Only needed if running frontend without backend
REACT_APP_API_KEY=your_tmdb_api_key_here
