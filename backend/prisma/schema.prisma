// Prisma schema for Flex-Watch production-grade persistence layer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  clerkId   String          @unique
  email     String?
  name      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  watchlist WatchlistItem[]
  bookings  Booking[]
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  mediaType   String   @default("movie") // "movie" or "tv"
  title       String
  overview    String?
  posterPath  String?
  backdropPath String?
  voteAverage Float    @default(0)
  releaseDate String?
  addedAt     DateTime @default(now())

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
  @@index([tmdbId])
}

model Theater {
  id        String   @id @default(cuid())
  name      String
  city      String
  screens   Screen[]
  createdAt DateTime @default(now())
}

model Screen {
  id         String   @id @default(cuid())
  theaterId  String
  theater    Theater  @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  name       String
  format     String   @default("IMAX") // "2D", "3D", "IMAX", "Dolby Atmos"
  totalSeats Int      @default(56)
  shows      Show[]
  createdAt  DateTime @default(now())

  @@index([theaterId])
}

model Show {
  id            String         @id @default(cuid())
  screenId      String
  screen        Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)
  movieId       Int
  movieTitle    String
  startTime     DateTime
  basePrice     Float          @default(12.0)
  bookings      Booking[]
  reservedSeats ReservedSeat[]
  createdAt     DateTime       @default(now())

  @@index([screenId])
  @@index([movieId, startTime])
}

model Booking {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String   @unique
  movieId        Int
  movieTitle     String
  showtime       DateTime
  showId         String?
  show           Show?    @relation(fields: [showId], references: [id], onDelete: SetNull)
  seats           String   // Comma-separated or JSON string of seat identifiers e.g. "A1,A2"
  totalAmount     Float
  status          String   @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "CONFIRMED", "CANCELLED", "EXPIRED"
  stripeSessionId String?  @unique
  paymentIntentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservedSeats  ReservedSeat[]

  @@index([userId])
  @@index([movieId])
  @@index([showId])
  @@index([stripeSessionId])
}

model ReservedSeat {
  id        String   @id @default(cuid())
  movieId   Int
  showtime  DateTime
  showId    String?
  show      Show?    @relation(fields: [showId], references: [id], onDelete: SetNull)
  seatCode  String   // e.g. "A1", "C4"
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([movieId, showtime, seatCode])
  @@index([bookingId])
  @@index([movieId, showtime])
  @@index([showId])
}
