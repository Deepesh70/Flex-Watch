# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/flexwatch_db?schema=public"

# The Movie Database (TMDB) API Key (Kept secure on backend)
TMDB_API_KEY=your_tmdb_api_key_here

# Clerk Authentication Keys (From https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
